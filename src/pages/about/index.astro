---
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import fotoPerfil from '../../assets/yoLinkedin.jpeg';
import TechBadge from '../../components/TechBadge.astro';

const technologyGroups = [
  { title: 'Datos y análisis', technologies: ['python', 'sql', 'postgres', 'pandas', 'excel', 'powerbi'] },
  { title: 'Desarrollo', technologies: ['java', 'springboot', 'typescript', 'angular', 'fastapi'] },
  { title: 'Herramientas / infraestructura', technologies: ['git', 'linux', 'docker'] },
];

const lcpImage = await getImage({
  src: fotoPerfil,
  width: 400,
  format: 'webp',
});
---

<Layout
  preloadImage={lcpImage.src}
  seoTitle="Sobre Alvaro Vidal | Politólogo y Analista de Datos, Procesos y Automatización"
  seoDescription="Politólogo por la UNMSM con especialización en Derecho Internacional y formación tecnológica en IDAT. Análisis de datos, procesos y automatización."
>
  <div class="max-w-5xl mx-auto pb-12">
    <div class="flex flex-col md:flex-row gap-5 md:items-start">

      <!-- ───[ S I D E B A R   —   D A T O S ]────────── -->
      <aside class="about-sidebar min-w-0 md:w-[30%] md:sticky md:top-4 md:self-start lg:top-8">
        <div class="about-profile-card relative flex flex-col border border-neutral-800 dark:border-neutral-600 bg-white dark:bg-neutral-900 shadow-[5px_5px_0_#111827] dark:shadow-none md:max-h-[calc(100dvh-6.5rem)]">

          <!-- ── foto en marco vertical ── -->
          <div class="about-profile-photo relative shrink-0 border-b-2 border-neutral-900 dark:border-neutral-700 overflow-hidden max-w-xs mx-auto w-full md:max-w-none md:mx-0 md:min-h-0 md:flex-1 md:flex md:flex-col">
            <div class="absolute -top-2.5 -left-2.5 w-4 h-4 bg-neutral-900 dark:bg-neutral-800 z-10" />
            <div class="absolute -top-2.5 -right-2.5 w-4 h-4 bg-neutral-900 dark:bg-neutral-800 z-10" />
            <div class="pointer-events-none absolute inset-1 border border-neutral-900/10 dark:border-white/10 z-10" />
            <div class="aspect-[3/4] w-full bg-white dark:bg-neutral-900 overflow-hidden md:aspect-auto md:min-h-0 md:flex-1">
              <Image
                src={fotoPerfil}
                alt="Alva Vidal"
                width={400}
                height={400}
                widths={[280, 400]}
                sizes="(min-width: 768px) 30vw, 20rem"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="h-full w-full object-contain md:max-h-full"
              />
            </div>
          </div>

          <!-- ── nombre ── -->
          <div class="shrink-0 px-4 pt-3 pb-2 text-center border-b-2 border-neutral-900 dark:border-neutral-700 md:px-3 md:pt-2 md:pb-1.5 lg:px-4 lg:pt-3 lg:pb-2">
            <h1 class="text-xl font-extrabold tracking-tight text-blue-900 dark:text-[#D6A21E] md:text-lg lg:text-xl">
              Alva Vidal
            </h1>
            <p class="mt-1 text-neutral-600 dark:text-neutral-300 text-xs leading-relaxed tracking-wide">
              <span class="block font-semibold text-blue-900 dark:text-[#D6A21E]">Politólogo</span>
              <span class="block">Analista de Datos, Procesos y Automatización</span>
            </p>
          </div>

          <!-- ── tecnologías (más prominente) ── -->
          <div class="shrink-0 border-b-2 border-neutral-900 dark:border-neutral-700 px-4 py-3 md:px-3 md:py-2 lg:px-4 lg:py-3">
            <h2 class="text-sm font-extrabold tracking-wider text-blue-900 dark:text-[#D6A21E] mb-2 md:mb-1.5 lg:mb-3 uppercase">
              Tecnologías
            </h2>
            <div class="space-y-3 md:space-y-2 lg:space-y-3">
              {technologyGroups.map((group) => (
                <section>
                  <h3 class="mb-1 text-[11px] font-semibold leading-snug text-neutral-600 dark:text-neutral-300">
                    {group.title}
                  </h3>
                  <div class="flex flex-wrap gap-1 lg:gap-1.5">
                    {group.technologies.map((tech) => <TechBadge tech={tech} compact />)}
                  </div>
                </section>
              ))}
            </div>
          </div>

          <!-- ── certificaciones ── -->
          <div class="shrink-0 border-b-2 border-neutral-900 dark:border-neutral-700 px-4 py-3 md:px-3 md:py-2 lg:px-4 lg:py-3">
            <a
              href="/certificaciones"
              class="group relative block w-full -rotate-1 border-2 border-neutral-900 dark:border-neutral-700 bg-amber-300 dark:bg-[#D6A21E] px-3 py-2.5 text-center shadow-[4px_4px_0_#111827] dark:shadow-none transition-all duration-150 hover:translate-x-1 hover:translate-y-1 hover:shadow-none active:translate-x-1.5 active:translate-y-1.5 active:shadow-none focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 dark:focus-visible:ring-[#D6A21E] focus-visible:ring-offset-2 md:py-2 lg:py-2.5"
            >
              <span class="pointer-events-none absolute -top-2 -right-1 rotate-6 border-2 border-neutral-900 dark:border-neutral-700 bg-white dark:bg-neutral-900 px-1.5 py-0.5 text-[9px] font-extrabold uppercase tracking-widest text-neutral-900 dark:text-[#D6A21E] shadow-[2px_2px_0_#111827] dark:shadow-none">
                ¡Clic!
              </span>
              <span class="inline-flex w-full items-center justify-center gap-2 text-sm font-extrabold uppercase tracking-wide text-amber-950 md:text-xs lg:text-sm">
                Certificados
                <span class="text-base transition-transform duration-150 group-hover:translate-x-0.5 md:text-sm lg:text-base" aria-hidden="true">→</span>
              </span>
            </a>
          </div>

          <!-- ── contacto ── -->
          <div class="shrink-0 px-4 py-3 space-y-1 md:px-3 md:py-2 md:space-y-0.5 lg:px-4 lg:py-3 lg:space-y-1">
            <div class="flex items-center gap-2 text-sm text-neutral-600 dark:text-neutral-400 md:text-xs lg:text-sm">
              <span>📍</span>
              <span>Lima, Perú</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-neutral-600 dark:text-neutral-400 md:text-xs lg:text-sm">
              <span>📞</span>
              <span>912 720 449</span>
            </div>
            <div class="flex items-start gap-2 text-sm text-neutral-600 dark:text-neutral-400 md:text-xs lg:text-sm">
              <span>✉️</span>
              <span class="break-all">alvaro.vidal1403@gmail.com</span>
            </div>
            <div class="flex items-start gap-2 text-sm text-neutral-600 dark:text-neutral-400 md:text-xs lg:text-sm">
              <span>✉️</span>
              <span class="break-all">alvavidal.1403@proton.me</span>
            </div>
          </div>

        </div>
      </aside>

      <!-- ───[ M A I N   —   C V ]──────────────────── -->
      <main class="md:w-[70%] min-w-0 space-y-5">

        <!-- ── PERFIL PROFESIONAL ── -->
        <section>
          <div class="flex items-center gap-2 border-b-2 border-neutral-900 dark:border-neutral-700 pb-1.5 mb-3">
            <span class="h-px w-5 bg-blue-700/70 dark:bg-[#D6A21E]/40"></span>
            <h2 class="text-base font-extrabold tracking-wider text-blue-900 dark:text-[#D6A21E] uppercase">
              Perfil Profesional
            </h2>
          </div>
          <div class="relative border border-neutral-800 dark:border-neutral-600 bg-white dark:bg-neutral-900 p-4 shadow-[4px_4px_0_#111827] dark:shadow-none">
            <div class="absolute -top-2.5 -left-2.5 w-4 h-4 bg-neutral-900 dark:bg-neutral-800" />
            <div class="absolute -top-2.5 -right-2.5 w-4 h-4 bg-neutral-900 dark:bg-neutral-800" />
            <div class="pointer-events-none absolute inset-1 border border-neutral-900/10 dark:border-white/10" />
            <div class="space-y-3">
              <div class="flex items-center gap-2 mb-0.5">
                <span class="h-px w-5 bg-blue-700/70 dark:bg-[#D6A21E]/40 shrink-0"></span>
              </div>
              <div>
                <p class="text-sm text-neutral-700 dark:text-neutral-400 leading-relaxed">
                  Soy <span class="underline decoration-[5px] decoration-yellow-500 dark:decoration-[#D6A21E] underline-offset-4">politólogo, Bachiller en Ciencia Política por la UNMSM</span>, formado en la Facultad de Derecho y Ciencia Política, con especialización en <span class="underline decoration-[5px] decoration-yellow-500 dark:decoration-[#D6A21E] underline-offset-4">Derecho Internacional</span> por la Universidad Simón Bolívar (Colombia). Mi base combina investigación, análisis político y comprensión de las instituciones y del marco normativo.
                </p>
              </div>
              <div>
                <p class="text-sm text-neutral-700 dark:text-neutral-400 leading-relaxed">
                  Tengo experiencia en presupuesto, logística, proveedores y contratos. Trabajo con datos operativos, trazabilidad y seguimiento, utilizando <span class="font-semibold text-neutral-800 dark:text-neutral-200">Python, SQL, Excel y Power BI</span> para analizar información y automatizar tareas.
                </p>
              </div>
              <div>
                <p class="text-sm text-neutral-700 dark:text-neutral-400 leading-relaxed">
                  Estudio <span class="underline decoration-[5px] decoration-yellow-500 dark:decoration-[#D6A21E] underline-offset-4">Desarrollo de Sistemas Frontend y Backend en IDAT</span> y desarrollo software a medida como proyecto de emprendimiento. Integro esta formación tecnológica con mi base política y normativa para mejorar procesos y construir soluciones en distintos contextos.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- ── EXPERIENCIA LABORAL ── -->
        <section>
          <div class="flex items-center gap-2 border-b-2 border-neutral-900 dark:border-neutral-700 pb-1.5 mb-3">
            <span class="h-px w-5 bg-blue-700/70 dark:bg-[#D6A21E]/40"></span>
            <h2 class="text-base font-extrabold tracking-wider text-blue-900 dark:text-[#D6A21E] uppercase">
              Experiencia Laboral
            </h2>
          </div>

          <div class="relative border border-neutral-800 dark:border-neutral-600 bg-white dark:bg-neutral-900 p-5 shadow-[5px_5px_0_#111827] dark:shadow-none">
            <div class="absolute -top-3 -left-3 w-5 h-5 bg-neutral-900 dark:bg-neutral-800" />
            <div class="absolute -top-3 -right-3 w-5 h-5 bg-neutral-900 dark:bg-neutral-800" />
            <div class="pointer-events-none absolute inset-1 border border-neutral-900/10 dark:border-white/10" />

            <div class="space-y-6">

              <!-- Job 1 -->
              <article class="space-y-1.5">
                <div class="flex items-center gap-2 mb-0.5">
                  <span class="h-px w-5 bg-blue-700/70 dark:bg-[#D6A21E]/40 shrink-0"></span>
                </div>
                <h4 class="text-base font-extrabold text-blue-900 dark:text-[#D6A21E] leading-tight">Analista de información</h4>
                <p class="text-sm text-neutral-500 dark:text-neutral-400">
                  🏢 Inversiones e Innovaciones Cristhi E.I.R.L · 📍 Lima, Perú · Ene. 2026 - May. 2026
                </p>
                <ul class="space-y-1">
                  <li class="text-sm font-bold text-neutral-700 dark:text-neutral-400 leading-relaxed flex gap-1.5">
                    <span class="mt-1 shrink-0 text-neutral-400 dark:text-neutral-500">–</span>
                    <span>Análisis de información administrativa y presupuestal vinculada a operaciones como proveedor del Estado mediante Perú Compras.</span>
                  </li>
                  <li class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed flex gap-1.5">
                    <span class="mt-1 shrink-0 text-neutral-400 dark:text-neutral-500">–</span>
                    <span>Consolidación y validación de órdenes de compra, órdenes de servicio y documentación de sustento.</span>
                  </li>
                  <li class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed flex gap-1.5">
                    <span class="mt-1 shrink-0 text-neutral-400 dark:text-neutral-500">–</span>
                    <span>Automatización de reportes para el seguimiento de contrataciones y pagos, utilizando información pública del SIAF sobre ejecución presupuestal, compromisos y devengados.</span>
                  </li>
                </ul>
              </article>

              <hr class="border-t border-neutral-200/60 dark:border-neutral-700" />

              <!-- Job 2 -->
              <article class="space-y-1.5">
                <div class="flex items-center gap-2 mb-0.5">
                  <span class="h-px w-5 bg-blue-700/70 dark:bg-[#D6A21E]/40 shrink-0"></span>
                </div>
                <h4 class="text-base font-extrabold text-blue-900 dark:text-[#D6A21E] leading-tight">Analista Administrativo en Presupuesto — Oficina de Planeamiento y Presupuesto</h4>
                <p class="text-sm text-neutral-500 dark:text-neutral-400">
                  🏢 Red de Salud de Huarochirí · 📍 Lima, Perú · Oct. 2025 - Dic. 2025
                </p>
                <ul class="space-y-1">
                  <li class="text-sm font-bold text-neutral-700 dark:text-neutral-400 leading-relaxed flex gap-1.5">
                    <span class="mt-1 shrink-0 text-neutral-400 dark:text-neutral-500">–</span>
                    <span>Identifiqué saldos de más de S/ 3 millones en certificados presupuestales sin compromiso.</span>
                  </li>
                  <li class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed flex gap-1.5">
                    <span class="mt-1 shrink-0 text-neutral-400 dark:text-neutral-500">–</span>
                    <span>Implementé automatización de reportes en Excel y Power BI mediante macros VBA y Pandas en Python.</span>
                  </li>
                  <li class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed flex gap-1.5">
                    <span class="mt-1 shrink-0 text-neutral-400 dark:text-neutral-500">–</span>
                    <span>Realicé validación y control de información presupuestal.</span>
                  </li>
                </ul>
              </article>

              <hr class="border-t border-neutral-200/60 dark:border-neutral-700" />

              <!-- Job 3 -->
              <article class="space-y-1.5">
                <div class="flex items-center gap-2 mb-0.5">
                  <span class="h-px w-5 bg-blue-700/70 dark:bg-[#D6A21E]/40 shrink-0"></span>
                </div>
                <h4 class="text-base font-extrabold text-blue-900 dark:text-[#D6A21E] leading-tight">Analista administrativo — Gerencia de Logística</h4>
                <p class="text-sm text-neutral-500 dark:text-neutral-400">
                  🏢 EMAPE · 📍 Lima, Perú · Ene. 2025 - Ago. 2025
                </p>
                <ul class="space-y-1">
                  <li class="text-sm font-bold text-neutral-700 dark:text-neutral-400 leading-relaxed flex gap-1.5">
                    <span class="mt-1 shrink-0 text-neutral-400 dark:text-neutral-500">–</span>
                    <span>Recuperé más de S/ 80,000 en certificados sin rebajar (solo comprometidos y sin devengar).</span>
                  </li>
                  <li class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed flex gap-1.5">
                    <span class="mt-1 shrink-0 text-neutral-400 dark:text-neutral-500">–</span>
                    <span>Asistí en la ejecución de más de 600 órdenes de servicios mensuales.</span>
                  </li>
                  <li class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed flex gap-1.5">
                    <span class="mt-1 shrink-0 text-neutral-400 dark:text-neutral-500">–</span>
                    <span>Implementé reportes para mejorar la trazabilidad de los datos logísticos.</span>
                  </li>
                </ul>
              </article>

              <hr class="border-t border-neutral-200/60 dark:border-neutral-700" />

              <!-- Job 4 -->
              <article class="space-y-1.5">
                <div class="flex items-center gap-2 mb-0.5">
                  <span class="h-px w-5 bg-blue-700/70 dark:bg-[#D6A21E]/40 shrink-0"></span>
                </div>
                <h4 class="text-base font-extrabold text-blue-900 dark:text-[#D6A21E] leading-tight">Analista Administrativo — Subgerencia de Concesiones y Eventos</h4>
                <p class="text-sm text-neutral-500 dark:text-neutral-400">
                  🏢 SERPAR · 📍 Lima, Perú · Jun. 2024 - Oct. 2024
                </p>
                <ul class="space-y-1">
                  <li class="text-sm font-bold text-neutral-700 dark:text-neutral-400 leading-relaxed flex gap-1.5">
                    <span class="mt-1 shrink-0 text-neutral-400 dark:text-neutral-500">–</span>
                    <span>Administré concesiones y arrendamientos en parques metropolitanos, desarrollando análisis históricos y modelos de valoración para tarifas comerciales.</span>
                  </li>
                  <li class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed flex gap-1.5">
                    <span class="mt-1 shrink-0 text-neutral-400 dark:text-neutral-500">–</span>
                    <span>Realice el seguimiento y trazabilidad de los cobros de los concesionarios en los parques bajo mi administración.</span>
                  </li>
                </ul>
                <div class="mt-2 pl-2 space-y-0.5">
                  <p class="text-xs font-bold text-blue-900 dark:text-[#D6A21E] mb-1">Parques administrados:</p>
                  <ul class="space-y-0.5">
                    <li class="text-sm text-neutral-600 dark:text-neutral-400">– Club Metropolitano Huáscar (Villa El Salvador)</li>
                    <li class="text-sm text-neutral-600 dark:text-neutral-400">– Club Metropolitano Huayna Cápac (San Juan de Miraflores)</li>
                    <li class="text-sm text-neutral-600 dark:text-neutral-400">– Parque de La Muralla (Cercado de Lima)</li>
                    <li class="text-sm text-neutral-600 dark:text-neutral-400">– Parque Alameda Las Malvinas (Cercado de Lima)</li>
                    <li class="text-sm text-neutral-600 dark:text-neutral-400">– Parque Universitario (Cercado de Lima)</li>
                    <li class="text-sm text-neutral-600 dark:text-neutral-400">– Parque Metropolitano "Coronel Miguel Baquero" (Cercado de Lima)</li>
                    <li class="text-sm text-neutral-600 dark:text-neutral-400">– Parque de los Anillos (Ate)</li>
                  </ul>
                </div>
              </article>

              <hr class="border-t border-neutral-200/60 dark:border-neutral-700" />

              <!-- Job 5 -->
              <article class="space-y-1.5">
                <div class="flex items-center gap-2 mb-0.5">
                  <span class="h-px w-5 bg-blue-700/70 dark:bg-[#D6A21E]/40 shrink-0"></span>
                </div>
                <h4 class="text-base font-extrabold text-blue-900 dark:text-[#D6A21E] leading-tight">Analista de Adquisiciones y Gestión Administrativa</h4>
                <p class="text-sm text-neutral-500 dark:text-neutral-400">
                  🏢 V&V Soluciones · 📍 Lima, Perú · May. 2023 - Jun. 2024
                </p>
                <ul class="space-y-1">
                  <li class="text-sm font-bold text-neutral-700 dark:text-neutral-400 leading-relaxed flex gap-1.5">
                    <span class="mt-1 shrink-0 text-neutral-400 dark:text-neutral-500">–</span>
                    <span>Validé y controlé información en contratos, órdenes de servicio y registros administrativos.</span>
                  </li>
                  <li class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed flex gap-1.5">
                    <span class="mt-1 shrink-0 text-neutral-400 dark:text-neutral-500">–</span>
                    <span>Organicé de manera efectiva documentos para mejorar la trazabilidad y seguimiento de procesos.</span>
                  </li>
                  <li class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed flex gap-1.5">
                    <span class="mt-1 shrink-0 text-neutral-400 dark:text-neutral-500">–</span>
                    <span>Di soporte a cobranza mediante verificación de estados de pago.</span>
                  </li>
                </ul>
              </article>

            </div>
          </div>
        </section>

        <!-- ── EDUCACIÓN ── -->
        <section>
          <div class="flex items-center gap-2 border-b-2 border-neutral-900 dark:border-neutral-700 pb-1.5 mb-3">
            <span class="h-px w-5 bg-blue-700/70 dark:bg-[#D6A21E]/40"></span>
            <h2 class="text-base font-extrabold tracking-wider text-blue-900 dark:text-[#D6A21E] uppercase">
              Educación
            </h2>
          </div>

          <div class="space-y-3">
            <article class="relative border border-neutral-800 dark:border-neutral-600 bg-white dark:bg-neutral-900 p-3 shadow-[4px_4px_0_#111827] dark:shadow-none">
              <div class="absolute -top-2.5 -left-2.5 w-4 h-4 bg-neutral-900 dark:bg-neutral-800" />
              <div class="absolute -top-2.5 -right-2.5 w-4 h-4 bg-neutral-900 dark:bg-neutral-800" />
              <div class="pointer-events-none absolute inset-1 border border-neutral-900/10 dark:border-white/10" />
              <div class="flex items-center gap-2 mb-1">
                <span class="h-px w-5 bg-blue-700/70 dark:bg-[#D6A21E]/40 shrink-0"></span>
              </div>
              <h4 class="text-sm font-extrabold text-blue-900 dark:text-[#D6A21E]">Bachiller en Ciencia Política</h4>
              <p class="text-sm text-neutral-500 dark:text-neutral-400">🇵🇪 Universidad Nacional Mayor de San Marcos | 2016 - 2021</p>
            </article>

            <article class="relative border border-neutral-800 dark:border-neutral-600 bg-white dark:bg-neutral-900 p-3 shadow-[4px_4px_0_#111827] dark:shadow-none">
              <div class="absolute -top-2.5 -left-2.5 w-4 h-4 bg-neutral-900 dark:bg-neutral-800" />
              <div class="absolute -top-2.5 -right-2.5 w-4 h-4 bg-neutral-900 dark:bg-neutral-800" />
              <div class="pointer-events-none absolute inset-1 border border-neutral-900/10 dark:border-white/10" />
              <div class="flex items-center gap-2 mb-1">
                <span class="h-px w-5 bg-blue-700/70 dark:bg-[#D6A21E]/40 shrink-0"></span>
              </div>
              <h4 class="text-sm font-extrabold text-blue-900 dark:text-[#D6A21E]">Especialización en Derecho Internacional</h4>
              <p class="text-sm text-neutral-500 dark:text-neutral-400">🇨🇴 Universidad Simón Bolívar (Colombia) | 2021</p>
            </article>

            <article class="relative border border-neutral-800 dark:border-neutral-600 bg-white dark:bg-neutral-900 p-3 shadow-[4px_4px_0_#111827] dark:shadow-none">
              <div class="absolute -top-2.5 -left-2.5 w-4 h-4 bg-neutral-900 dark:bg-neutral-800" />
              <div class="absolute -top-2.5 -right-2.5 w-4 h-4 bg-neutral-900 dark:bg-neutral-800" />
              <div class="pointer-events-none absolute inset-1 border border-neutral-900/10 dark:border-white/10" />
              <div class="flex items-center gap-2 mb-1">
                <span class="h-px w-5 bg-blue-700/70 dark:bg-[#D6A21E]/40 shrink-0"></span>
              </div>
              <h4 class="text-sm font-extrabold text-blue-900 dark:text-[#D6A21E]">Desarrollo de Sistemas Frontend y Backend</h4>
              <p class="text-sm text-neutral-500 dark:text-neutral-400">🇵🇪 Instituto Idat | 2025 — En curso (4to Ciclo)</p>
            </article>
          </div>
        </section>

      </main>
    </div>
  </div>
</Layout>

<style>
  /* Solo /about — tarjeta lateral adaptable al contenido y la altura disponible.
     Breakpoints Tailwind del proyecto: sm 640px, md 768px, lg 1024px, xl 1280px */

  @media (min-width: 768px) {
    .about-profile-card {
      max-height: calc(100dvh - 6.5rem);
